    "@hono/zod-openapi": "1.6.3",
    "@krug/db": "workspace:*",
    "@krug/domain": "workspace:*",
    "@scalar/hono-api-reference": "0.12.19",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.17",
    "luxon": "3.7.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/luxon": "3.7.6",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}

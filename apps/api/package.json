{
  "name": "@krug/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "openapi": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {

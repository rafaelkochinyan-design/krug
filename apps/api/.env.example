# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=8787
# Postgres connection string (Neon in staging/production). Leave empty locally to use an in-memory PGlite database.
DATABASE_URL=
# Public URL of the web app, used to build invite links.
APP_URL=http://localhost:8081
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:8081
# TEMPORARY until step 0.7 (Better Auth): lets local clients act as a user via the x-dev-user-id header.
# Refused when NODE_ENV=production.
DEV_AUTH=1
